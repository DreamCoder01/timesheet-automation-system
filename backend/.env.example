# Application Operating Mode
ENVIRONMENT=development
APP_SECRET_KEY=replace_this_with_a_secure_crypto_hash_in_production

# Presentation Layer Server Binding Configurations
HOST=0.0.0.0
PORT=8000

# Data Persistence Core Connection Layer String 
# Default configuration points directly to a local file-backed SQLite database
DATABASE_URL=sqlite:///./timesheet_automation.db

# Global Cross-Origin Resource Sharing (CORS) System Permissions
# Adjust this path specifically to authorize your local Next.js frontend port
ALLOWED_ORIGINS=["http://localhost:3000"]
