# ====================================================================
# 1. PYTHON BACKEND SERVICE BOUNDARIES (Recursive Cache Invalidation)
# ====================================================================
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
backend/env/
backend/venv/
backend/ENV/
backend/.env
backend/.coverage
backend/htmlcov/
backend/.pytest_cache/
backend/timesheet_automation.db

# ====================================================================
# 2. NEXT.JS FRONTEND APPLICATION BOUNDARIES 
# ====================================================================
frontend/.next/
frontend/node_modules/
frontend/package-lock.json
frontend/coverage/
frontend/out/
frontend/dist/
frontend/.npm
frontend/build/
frontend/next-env.d.ts
frontend/.next-types/

# ====================================================================
# 3. GLOBAL SYSTEM UTILITIES & LOCAL DATABASES
# ====================================================================
*.db
*.sqlite3
.DS_Store
Thumbs.db
backend/package-lock.json
